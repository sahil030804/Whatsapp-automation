    {
      "name": "Webhook",
      "description": "WhatsApp webhook endpoints for receiving message events from Meta.",
      "item": [
        {
          "name": "Verify Challenge",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/meta/webhook?hub.mode=subscribe&hub.challenge=123456789&hub.verify_token=jawab_ai_webhook_verify_2024",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "meta",
                "webhook"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.challenge",
                  "value": "123456789"
                },
                {
                  "key": "hub.verify_token",
                  "value": "jawab_ai_webhook_verify_2024"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Verified",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "123456789"
            }
          ]
        },
        {
          "name": "Receive Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"123456789012345\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15551234567\",\n              \"phone_number_id\": \"112233445566778\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"John Doe\"\n                },\n                \"wa_id\": \"15559876543\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"15559876543\",\n                \"id\": \"wamid.ABC123DEF456=\",\n                \"timestamp\": \"1716444000\",\n                \"text\": {\n                  \"body\": \"Hello! What are your business hours?\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/meta/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "meta",
                "webhook"
              ]
            }
          },
          "response": [
            {
              "name": "Accepted",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true\n}"
            }
          ]
        }
      ]
    },
